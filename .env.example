# Turntable-1's settings for Docker. Copy to .env (the installer does this for you).
# Everything else is on the settings page, at the gear.

# Your time zone: the nightly sync, quiet hours and the Flight log use it.
TZ=America/New_York

# The port to open the site on: http://<this machine>:8080
HTTP_PORT=8080

# The host's audio group, so the capture container can use the turntable (getent group audio).
AUDIO_GID=29

# Where things are kept on this machine.
CONFIG_DIR=./config
DATA_DIR=./data
# The album archive: point this at your NAS's mount to file albums there.
ARCHIVE_DIR=./archive

# The image, and which version: "latest", or a release such as 1.30 or 1.30.0 to pin it.
IMAGE=ghcr.io/torinml/turntable-1
TAG=latest
